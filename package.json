{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "codegen": "graphql-codegen",
    "schema:puzzle": "ts-json-schema-generator --path src/components/editor/json/schemaTypes.ts --type SerializedPuzzleSchema --tsconfig tsconfig.app.json --no-type-check -o src/components/editor/json/puzzle-schema.json"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/json": "^1.0.3",
    "@mdi/js": "^7.4.47",
    "@rails/actioncable": "^8.1.301",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/vue-3": "^3.30.1",
    "@vue/apollo-composable": "^4.2.2",
    "@vueuse/core": "^14.4.0",
    "apollo-upload-client": "^17.0.0",
    "best-effort-json-parser": "^1.5.1",
    "codemirror-json-schema": "^0.8.1",
    "dompurify": "^3.4.13",
    "driver.js": "^1.8.0",
    "graphql": "^16.14.2",
    "graphql-ruby-client": "^1.15.2",
    "js-sha256": "^0.11.1",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.4",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@graphql-codegen/introspection": "^6.1.0",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-graphql-files-modules": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.2.0",
    "@types/rails__actioncable": "^8.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "tailwindcss": "^4.2.4",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-graphql-loader": "^5.1.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.3.10"
  }
}
