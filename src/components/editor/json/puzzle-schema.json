    "TextData": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "pos": {
          "$ref": "#/definitions/CosmeticPos"
        },
        "presetId": {
          "type": "string"
        },
        "rotation": {
          "type": "number"
