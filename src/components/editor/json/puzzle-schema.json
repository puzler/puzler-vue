        {
          "$ref": "#/definitions/ArrowData"
        },
        {
          "$ref": "#/definitions/ConstraintLineData"
        },
        {
          "$ref": "#/definitions/CosmeticLineData"
        },
        {
          "$ref": "#/definitions/KillerCageData"
        },
        {
          "$ref": "#/definitions/ExtraRegionData"
        },
        {
          "$ref": "#/definitions/CloneData"
