      "additionalProperties": false,
      "properties": {
        "fillColor": {
          "type": "string"
        },
        "height": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "shapeType": {
          "$ref": "#/definitions/ShapeType"
        },
        "sizeLinked": {
          "type": "boolean"
        },
        "strokeColor": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number"
        },
        "textColor": {
          "type": "string"
        },
        "textSize": {
          "type": "number"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "shapeType",
        "fillColor",
        "strokeColor",
        "strokeWidth",
        "width",
        "height",
        "sizeLinked",
        "textColor",
        "textSize"
      ],
      "type": "object"
    },
