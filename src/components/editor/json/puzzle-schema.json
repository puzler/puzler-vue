    "TextPreset": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "style": {
          "$ref": "#/definitions/TextStyle"
        }
      },
      "required": [
        "id",
        "label",
        "style"
      ],
      "type": "object"
    },
    "TextStyle": {
      "additionalProperties": false,
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "fontSize": {
          "type": "number"
